# 服务端原始包：以分卷形式入库（server/wd-parts/，每卷 <100MB）
# server/wd.zip 是分卷合并后的完整包（构建前由 server/assemble-wdzip.sh 生成），不入库
server/wd.zip

# 客户端产物（太大不入库）
client/*.apk
client/*.apk.idsig
client/*.png

# 运行产物
logs/
*.log
.env

# 排查/调试脚本（tests 下只在库保留 healthcheck.sh，其余临时脚本不提交）
tests/diag-*
tests/check-*
tests/cmp-*
tests/fix-*
tests/gs-*
tests/capture-*
tests/trace-*
tests/verify-*
tests/restart-*
tests/hotfix-*
tests/really-*
tests/recover-*
tests/stop-*
tests/fresh-*
tests/test-*
tests/inspect-*

# 系统
.DS_Store
Thumbs.db
