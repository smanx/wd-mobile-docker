[mysqld]
datadir=/var/lib/mysql
socket=/var/lib/mysql/mysql.sock
user=mysql
symbolic-links=0

# 兼容老服务端：关闭严格模式与性能-schema，放大连接数（教程要求 max_connections=30000）
sql_mode=""
performance_schema=OFF
max_connections=30000
max_allowed_packet=64M
back_log=2048
thread_cache_size=128

# 全局 latin1（与原教程 mysql-5.6 默认一致）。
# 关键：老服务端 gs/aaa 用 GBK(视为 latin1) 保存区服名，若客户端连接层是 utf8
# 会在比较中文名时报 "Illegal mix of collations" → game_server_list 查空 →
# gs 卡在 Try to obtain game_server_list、客户端显示"服务器维护中"。
# 因此连接层也必须 latin1，并关闭客户端握手协商。
character-set-server = latin1
collation-server = latin1_swedish_ci
init_connect = 'SET NAMES latin1'
character-set-client-handshake = 0
skip-character-set-client-handshake

innodb_buffer_pool_size=1G
innodb_flush_method=O_DIRECT
innodb_file_per_table=1

log-error=/wd/logs/mysqld.log

[client]
socket=/var/lib/mysql/mysql.sock

[mysqld_safe]
log-error=/wd/logs/mysqld.log
pid-file=/var/run/mysqld/mysqld.pid
